# ==================== 生活小秘 - systemd 服务（免 Docker 方案） ====================
# 放置位置：/etc/systemd/system/lexiang.service
# 前提：服务器已安装 Node.js 22+，项目放在 /opt/lexiang-life
#
# 启用：
#   sudo cp deploy/lexiang.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now lexiang
#
# 常用命令：
#   sudo systemctl status lexiang      # 查看状态
#   sudo journalctl -u lexiang -f      # 查看日志

[Unit]
Description=生活小秘 - 本地生活服务平台后端
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/lexiang-life
# 使用 Node 内置 http，无需额外进程管理；如需自动重启单进程可去掉注释：
# Restart=always
# RestartSec=5

Environment=NODE_ENV=production
Environment=PORT=3000

ExecStart=/usr/bin/node server/server.js
ExecReload=/bin/kill -HUP $MAINPID

# 安全加固
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/lexiang-life

[Install]
WantedBy=multi-user.target
