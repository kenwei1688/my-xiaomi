# ===== 生活小秘 · 后端环境变量示例 =====
# 复制本文件为 .env（与 server.js 同目录），或通过部署平台的环境变量面板逐项配置。
# 生产环境【必须】覆盖 JWT_SECRET 与 ADMIN_TOKEN，否则存在安全风险。

# ---------- 基础 ----------
# 服务监听端口（默认 3000）
PORT=3000

# 运行环境：production / development（影响 ADMIN_TOKEN 的本地默认值）
NODE_ENV=production

# 数据目录（SQLite 持久化文件 xiaomi.db 所在目录，默认 ./data）
# 部署平台挂持久卷时，把卷挂到该目录即可实现数据持久化
# DATA_DIR=./data

# ---------- 安全 ----------
# JWT 签名密钥：生产环境务必改为随机长字符串，例如：
#   JWT_SECRET=$(openssl rand -base64 48)
# 默认值仅限本地开发，切勿用于生产。
JWT_SECRET=xiaomi-secretary-dev-secret-change-me

# 管理员令牌（用于 /api/admin 等管理接口）
# 生产环境必须显式设置；本地开发未设置时默认 'dev-admin'
ADMIN_TOKEN=

# ---------- LLM 增强（可选；未配置时自动回退规则引擎兜底） ----------
# 兼容 OpenAI 风格的 chat/completions 接口（DeepSeek / 通义 / 混元等均可）
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_API_KEY=sk-xxxx
# LLM_MODEL=deepseek-chat

# ---------- 下单供应商（可选；默认 mock 模拟下单） ----------
# 全局默认供应商：mock / meituan / ctrip
# BOOKING_PROVIDER=mock
# 可按品类单独指定，例如：BOOKING_PROVIDER_HOTEL=ctrip

# 美团通道（需真实商户资质与密钥）
# MEITUAN_APP_KEY=
# MEITUAN_APP_SECRET=
# MEITUAN_API_BASE=

# 携程通道（需真实商户资质与密钥）
# CTRIP_APP_KEY=
# CTRIP_APP_SECRET=
# CTRIP_API_BASE=
