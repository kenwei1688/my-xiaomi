# 复制本文件为 .env（与 server.js 同目录）并按需修改。
# 部署时【必须】覆盖 JWT_SECRET，否则 token 可被伪造。

# 服务监听端口（默认 3000）
PORT=3000

# Token 签名密钥：生产环境改为一段随机长字符串，例如：
#   JWT_SECRET=$(openssl rand -base64 48)
# 警告：使用默认值 'life-secret-change-me-in-prod' 仅适用于本地开发。
JWT_SECRET=life-secret-change-me-in-prod

# （可选）持久化数据文件路径，默认 server/data/db.json
# DATA_FILE=./data/db.json
