/* pages/assistant/assistant.wxss */
.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #F5F5F7;
}

.status-bar-placeholder {
  height: var(--status-bar-height, 44rpx);
  background: #fff;
}

/* 头部 */
.assistant-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 24rpx;
  background: #fff;
}

.assistant-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FF6B35, #FFB627);
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-emoji {
  font-size: 40rpx;
}

.assistant-info {
  display: flex;
  flex-direction: column;
}

.assistant-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #1A1A1A;
}

.assistant-desc {
  font-size: 22rpx;
  color: #9B9B9B;
}

/* 快捷指令 */
.quick-actions {
  background: #fff;
  padding: 16rpx 24rpx 20rpx;
  margin-bottom: 8rpx;
}

.quick-action-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #6B6B6B;
  display: block;
  margin-bottom: 16rpx;
}

.quick-action-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.quick-action-item {
  width: calc(25% - 12rpx);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.qa-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.qa-emoji {
  font-size: 40rpx;
}

.qa-label {
  font-size: 22rpx;
  color: #1A1A1A;
}

/* 对话区域 */
.chat-area {
  flex: 1;
  overflow: hidden;
  padding: 16rpx 24rpx;
}

.chat-msg {
  display: flex;
  margin-bottom: 24rpx;
  gap: 12rpx;
  align-items: flex-start;
}

.chat-msg.user {
  flex-direction: row-reverse;
}

.chat-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.chat-avatar-emoji {
  font-size: 32rpx;
}

.chat-content-wrap {
  max-width: 75%;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.chat-msg.user .chat-content-wrap {
  align-items: flex-end;
}

.chat-bubble {
  padding: 20rpx 24rpx;
  border-radius: 24rpx;
  background: #fff;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.chat-msg.user .chat-bubble {
  background: linear-gradient(135deg, #FF6B35, #FF9A56);
}

.chat-msg.user .chat-text {
  color: #fff;
}

.chat-text {
  font-size: 28rpx;
  color: #1A1A1A;
  line-height: 1.6;
  white-space: pre-wrap;
}

/* 简单卡片 */
.chat-card {
  width: 100%;
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.chat-card-img {
  width: 100%;
  height: 160rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.chat-card-emoji {
  font-size: 64rpx;
}

.chat-card-body {
  padding: 16rpx 20rpx;
}

.chat-card-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1A1A1A;
  display: block;
  margin-bottom: 4rpx;
}

.chat-card-desc {
  font-size: 22rpx;
  color: #6B6B6B;
  display: block;
  margin-bottom: 12rpx;
}

.chat-card-btn {
  display: inline-block;
  padding: 8rpx 32rpx;
  background: linear-gradient(135deg, #FF6B35, #FF9A56);
  color: #fff;
  font-size: 24rpx;
  border-radius: 24rpx;
  font-weight: 600;
}

/* AI多卡片 */
.chat-cards {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.chat-merchant-card {
  display: flex;
  gap: 12rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.cc-img {
  width: 100rpx;
  height: 100rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.cc-emoji {
  font-size: 40rpx;
}

.cc-body {
  flex: 1;
  min-width: 0;
}

.cc-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #1A1A1A;
  display: block;
  margin-bottom: 4rpx;
}

.cc-meta {
  display: flex;
  gap: 12rpx;
  margin-bottom: 4rpx;
}

.cc-rating {
  font-size: 22rpx;
  color: #FF9500;
}

.cc-dist {
  font-size: 22rpx;
  color: #6B6B6B;
}

.cc-price {
  font-size: 22rpx;
  color: #FF6B35;
  font-weight: 600;
}

.cc-tags {
  display: flex;
  gap: 8rpx;
  flex-wrap: wrap;
}

.cc-tag {
  font-size: 18rpx;
  color: #6B6B6B;
  background: #F5F5F7;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
}

/* 操作按钮 */
.chat-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.chat-action-btn {
  padding: 10rpx 24rpx;
  background: rgba(255,107,53,0.1);
  color: #FF6B35;
  font-size: 24rpx;
  border-radius: 24rpx;
  font-weight: 500;
}

/* 打字指示器 */
.typing-indicator {
  display: flex;
  gap: 8rpx;
  padding: 4rpx 0;
}

.typing-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #D1D1D6;
  animation: typing 1.4s infinite;
}

.typing-dot:nth-child(2) {
  animation-delay: 0.2s;
}

.typing-dot:nth-child(3) {
  animation-delay: 0.4s;
}

@keyframes typing {
  0%, 60%, 100% { opacity: 0.3; transform: translateY(0); }
  30% { opacity: 1; transform: translateY(-6rpx); }
}

/* 输入栏 */
.chat-input-bar {
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom) + 120rpx);
  background: #fff;
  border-top: 1rpx solid #F5F5F7;
}

.chat-input-wrapper {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: #F5F5F7;
  border-radius: 40rpx;
  padding: 8rpx 8rpx 8rpx 24rpx;
}

.chat-input {
  flex: 1;
  height: 72rpx;
  font-size: 28rpx;
  color: #1A1A1A;
}

.chat-send-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FF6B35, #FF9A56);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.send-emoji {
  font-size: 32rpx;
}
