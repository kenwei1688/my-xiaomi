<!-- pages/assistant/assistant.wxml -->
<view class="page">
  <view class="status-bar-placeholder" style="height: {{statusBarHeight}}px;"></view>

  <!-- 头部 -->
  <view class="assistant-header">
    <view class="assistant-avatar">
      <text class="avatar-emoji">🤖</text>
    </view>
    <view class="assistant-info">
      <text class="assistant-name">小秘</text>
      <text class="assistant-desc">你的智能生活管家</text>
    </view>
  </view>

  <!-- 快捷指令 -->
  <view class="quick-actions">
    <text class="quick-action-title">小秘帮你办</text>
    <view class="quick-action-grid">
      <view
        class="quick-action-item"
        wx:for="{{quickActions}}"
        wx:key="name"
        data-name="{{item.name}}"
        bindtap="quickAction"
      >
        <view class="qa-icon" style="background:{{item.bg}};">
          <text class="qa-emoji">{{item.emoji}}</text>
        </view>
        <text class="qa-label">{{item.name}}</text>
      </view>
    </view>
  </view>

  <!-- 对话区域 -->
  <scroll-view
    scroll-y
    class="chat-area"
    scroll-into-view="{{scrollToView}}"
    scroll-with-animation
    enhanced
    show-scrollbar="{{false}}"
  >
    <view
      class="chat-msg {{item.type}}"
      wx:for="{{messages}}"
      wx:key="index"
      id="msg-{{index}}"
    >
      <!-- 头像 -->
      <view class="chat-avatar" style="background:{{item.avatarBg}};">
        <text class="chat-avatar-emoji">{{item.avatar}}</text>
      </view>
      <!-- 消息内容 -->
      <view class="chat-content-wrap">
        <!-- 文字气泡 -->
        <view class="chat-bubble">
          <text class="chat-text">{{item.text}}</text>
        </view>

        <!-- 简单卡片（本地回复） -->
        <view class="chat-card" wx:if="{{item.card}}">
          <view class="chat-card-img" style="background:{{item.card.bg}};">
            <text class="chat-card-emoji">{{item.card.emoji}}</text>
          </view>
          <view class="chat-card-body">
            <text class="chat-card-title">{{item.card.title}}</text>
            <text class="chat-card-desc">{{item.card.desc}}</text>
            <view class="chat-card-btn" data-btn="{{item.card.btn}}" bindtap="onCardBtnTap">
              {{item.card.btn}}
            </view>
          </view>
        </view>

        <!-- AI多卡片（后端回复） -->
        <view class="chat-cards" wx:if="{{item.cards && item.cards.length > 0}}">
          <view class="chat-merchant-card" wx:for="{{item.cards}}" wx:for-item="card" wx:key="name">
            <view class="cc-img" style="background:linear-gradient(135deg,#FF6B35,#FFAB40);">
              <text class="cc-emoji">🏪</text>
            </view>
            <view class="cc-body">
              <text class="cc-name">{{card.name}}</text>
              <view class="cc-meta">
                <text class="cc-rating">⭐ {{card.rating}}</text>
                <text class="cc-dist">{{card.distance}}</text>
                <text class="cc-price">¥{{card.avgPrice || card.price}}</text>
              </view>
              <view class="cc-tags" wx:if="{{card.tags}}">
                <text class="cc-tag" wx:for="{{card.tags}}" wx:for-item="t" wx:key="*this">{{t}}</text>
              </view>
            </view>
          </view>
        </view>

        <!-- 操作按钮 -->
        <view class="chat-actions" wx:if="{{item.actions && item.actions.length > 0}}">
          <view
            class="chat-action-btn"
            wx:for="{{item.actions}}"
            wx:for-item="action"
            wx:key="*this"
            data-text="{{action}}"
            bindtap="sendQuickMessage"
          >{{action}}</view>
        </view>
      </view>
    </view>

    <!-- 打字指示器 -->
    <view class="chat-msg bot" wx:if="{{isTyping}}">
      <view class="chat-avatar" style="background:linear-gradient(135deg,#FF6B35,#FFB627);">
        <text class="chat-avatar-emoji">🤖</text>
      </view>
      <view class="chat-bubble">
        <view class="typing-indicator">
          <view class="typing-dot"></view>
          <view class="typing-dot"></view>
          <view class="typing-dot"></view>
        </view>
      </view>
    </view>

    <view id="msg-bottom" style="height: 1rpx;"></view>
  </scroll-view>

  <!-- 输入栏 -->
  <view class="chat-input-bar">
    <view class="chat-input-wrapper">
      <input
        type="text"
        class="chat-input"
        placeholder="跟小秘说点什么..."
        value="{{inputValue}}"
        bindinput="onInput"
        bindconfirm="sendMessage"
        confirm-type="send"
      />
      <view class="chat-send-btn" bindtap="sendMessage">
        <text class="send-emoji">📤</text>
      </view>
    </view>
  </view>
</view>
