<!-- pages/recommend/recommend.wxml -->
<view class="page">
  <view class="status-bar-placeholder" style="height: {{statusBarHeight}}px;"></view>

  <scroll-view scroll-y class="page-scroll" enhanced show-scrollbar="{{false}}">

    <!-- 头部 -->
    <view class="rec-header">
      <text class="page-title">为你推荐</text>
      <text class="page-subtitle">基于你的偏好，千人千面</text>
    </view>

    <!-- 兴趣偏好设置 -->
    <view class="interest-bar">
      <view class="interest-label">
        <text class="interest-emoji">🌟</text>
        <text class="interest-text">兴趣偏好</text>
      </view>
      <view class="interest-tags">
        <view class="interest-tag" wx:for="{{selectedInterests}}" wx:key="id">
          {{item.emoji}} {{item.name}}
        </view>
        <text class="interest-empty" wx:if="{{selectedInterests.length === 0}}">暂未选择，点击编辑</text>
      </view>
      <view class="interest-edit" bindtap="openInterestPanel">
        <text class="edit-emoji">✏️</text>
        <text class="edit-text">编辑</text>
      </view>
    </view>

    <!-- 推荐内容流 -->
    <view class="recommend-feed" wx:if="{{filteredFeed.length > 0}}">
      <view
        class="recommend-card"
        wx:for="{{filteredFeed}}"
        wx:key="title"
        data-title="{{item.title}}"
        bindtap="onRecTap"
      >
        <view class="rec-img" style="background:{{item.bg}};">
          <text class="rec-emoji">{{item.emoji}}</text>
          <view class="rec-type-badge" style="background:{{item.typeColor}};">{{item.type}}</view>
        </view>
        <view class="rec-body">
          <text class="rec-title">{{item.title}}</text>
          <text class="rec-subtitle">{{item.subtitle}}</text>
          <view class="rec-meta">
            <text class="rec-rating">⭐ {{item.rating}}</text>
            <text class="rec-distance">{{item.distance}}</text>
            <text class="rec-sold">已售{{item.sold}}</text>
          </view>
          <view class="rec-price-row">
            <text class="rec-price">¥{{item.price}}</text>
            <text class="rec-unit">{{item.unit}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 空状态 -->
    <view class="empty-state" wx:else>
      <text class="empty-icon">📭</text>
      <text class="empty-text">暂无匹配内容\n试试勾选更多兴趣品类</text>
    </view>

    <view style="height: 140rpx;"></view>
  </scroll-view>

  <!-- 兴趣偏好编辑面板 -->
  <view class="interest-panel-overlay {{showInterestPanel ? 'show' : ''}}" catchtap="closeInterestPanel">
    <view class="interest-panel" catchtap="">
      <view class="interest-panel-header">
        <text class="panel-cancel" catchtap="closeInterestPanel">取消</text>
        <text class="panel-title">选择你感兴趣的品类</text>
        <text class="panel-confirm" catchtap="saveInterests">完成</text>
      </view>
      <view class="interest-panel-body">
        <view
          class="interest-option {{item.selected ? 'selected' : ''}}"
          wx:for="{{panelInterests}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="toggleInterest"
        >
          <view class="option-icon" style="background:{{item.bg}};">
            <text class="option-emoji">{{item.emoji}}</text>
          </view>
          <text class="option-name">{{item.name}}</text>
          <text class="option-check">{{item.selected ? '✓' : ''}}</text>
        </view>
      </view>
    </view>
  </view>
</view>
