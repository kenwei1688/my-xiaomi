/* pages/newest/newest.wxss */
.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.status-bar-placeholder {
  height: var(--status-bar-height, 44rpx);
  background: #fff;
}

.page-scroll {
  flex: 1;
  overflow: hidden;
}

/* 头部 */
.newest-header {
  padding: 24rpx 24rpx 16rpx;
  background: #fff;
}

.page-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1A1A1A;
  display: block;
}

.page-subtitle {
  font-size: 24rpx;
  color: #9B9B9B;
  margin-top: 8rpx;
}

/* 筛选栏 */
.filter-bar {
  width: 100%;
  white-space: nowrap;
  background: #fff;
  border-top: 1rpx solid #F5F5F7;
}

.filter-list {
  display: flex;
  gap: 16rpx;
  padding: 16rpx 24rpx;
}

.filter-item {
  display: inline-block;
  padding: 10rpx 28rpx;
  background: #F5F5F7;
  border-radius: 28rpx;
  font-size: 26rpx;
  color: #6B6B6B;
  flex-shrink: 0;
  transition: all 0.2s;
}

.filter-item.active {
  background: linear-gradient(135deg, #FF6B35, #FF9A56);
  color: #fff;
  font-weight: 600;
}

/* 新品动态流 */
.newest-feed {
  padding: 16rpx 24rpx;
}

.newest-post {
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

/* 用户信息 */
.post-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 24rpx 16rpx;
}

.post-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.post-avatar-emoji {
  font-size: 32rpx;
}

.post-user-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.post-username {
  font-size: 28rpx;
  font-weight: 600;
  color: #1A1A1A;
}

.post-time {
  font-size: 22rpx;
  color: #9B9B9B;
}

.post-official-tag {
  font-size: 18rpx;
  color: #FF6B35;
  background: rgba(255,107,53,0.1);
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  flex-shrink: 0;
}

/* 图片 */
.post-images {
  padding: 0 24rpx;
  display: flex;
  gap: 8rpx;
  margin-bottom: 16rpx;
}

.post-images.img-count-1 .post-img {
  width: 100%;
  height: 360rpx;
}

.post-images.img-count-2 .post-img {
  width: calc(50% - 4rpx);
  height: 280rpx;
}

.post-images.img-count-3 .post-img {
  width: calc(33.33% - 6rpx);
  height: 220rpx;
}

.post-img {
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.post-img-emoji {
  font-size: 64rpx;
}

/* 内容 */
.post-content {
  padding: 0 24rpx 16rpx;
}

.post-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1A1A1A;
  display: block;
  margin-bottom: 8rpx;
}

.post-desc {
  font-size: 26rpx;
  color: #6B6B6B;
  line-height: 1.6;
  display: block;
  margin-bottom: 12rpx;
}

.post-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 16rpx;
}

.post-tag {
  font-size: 22rpx;
  color: #007AFF;
  background: rgba(0,122,255,0.08);
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
}

.post-deal {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #FFF8F5;
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
}

.post-deal-price {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.post-deal-price .now {
  font-size: 36rpx;
  color: #FF6B35;
  font-weight: 700;
}

.post-deal-price .old {
  font-size: 22rpx;
  color: #C7C7CC;
  text-decoration: line-through;
}

.post-deal-btn {
  padding: 12rpx 36rpx;
  background: linear-gradient(135deg, #FF6B35, #FF9A56);
  color: #fff;
  font-size: 26rpx;
  border-radius: 28rpx;
  font-weight: 600;
}

/* 互动 */
.post-actions {
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 16rpx 24rpx;
  border-top: 1rpx solid #F5F5F7;
}

.post-action {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 16rpx;
}

.post-action.liked .action-emoji {
  animation: heartPop 0.3s;
}

@keyframes heartPop {
  0% { transform: scale(1); }
  50% { transform: scale(1.3); }
  100% { transform: scale(1); }
}

.action-emoji {
  font-size: 32rpx;
}

.action-count {
  font-size: 24rpx;
  color: #6B6B6B;
}

.post-action.liked .action-count {
  color: #FF3B30;
}

/* 评论 */
.post-comments {
  padding: 0 24rpx 16rpx;
  background: #FAFAFA;
  border-top: 1rpx solid #F5F5F7;
}

.post-comment {
  padding: 8rpx 0;
}

.comment-user {
  font-size: 24rpx;
  color: #007AFF;
  font-weight: 500;
}

.comment-text {
  font-size: 24rpx;
  color: #1A1A1A;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.empty-text {
  color: #9B9B9B;
  font-size: 26rpx;
  text-align: center;
}
