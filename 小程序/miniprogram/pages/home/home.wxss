/* pages/home/home.wxss */
.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.status-bar-placeholder {
  height: var(--status-bar-height, 44rpx);
  background: #fff;
}

.page-scroll {
  flex: 1;
  overflow: hidden;
}

/* 搜索栏 */
.home-search-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: #fff;
  gap: 16rpx;
}

.location-tag {
  display: flex;
  align-items: center;
  gap: 4rpx;
  flex-shrink: 0;
}

.loc-emoji {
  font-size: 28rpx;
}

.loc-text {
  font-size: 26rpx;
  font-weight: 600;
  color: #1A1A1A;
}

.search-input {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 12rpx;
  height: 68rpx;
  background: #F5F5F7;
  border-radius: 34rpx;
  padding: 0 24rpx;
}

.search-emoji {
  font-size: 28rpx;
  opacity: 0.6;
}

.search-placeholder {
  font-size: 26rpx;
  color: #9B9B9B;
}

.search-btn {
  font-size: 28rpx;
  color: #FF6B35;
  font-weight: 600;
  flex-shrink: 0;
}

/* 分类 */
.category-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 12rpx 16rpx;
  background: #fff;
  margin-bottom: 8rpx;
}

.category-item {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 0;
}

.cat-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
}

.cat-emoji {
  font-size: 44rpx;
}

.cat-label {
  font-size: 24rpx;
  color: #1A1A1A;
}

/* Section header */
.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 24rpx 16rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1A1A1A;
}

.more-link {
  font-size: 24rpx;
  color: #9B9B9B;
}

/* 轮播 */
.banner-swiper {
  width: 100%;
  height: 280rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
}

.banner-slide {
  width: 100%;
  height: 100%;
  border-radius: 20rpx;
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: center;
}

.banner-overlay {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: linear-gradient(135deg, rgba(0,0,0,0.15), rgba(0,0,0,0.05));
}

.banner-content {
  position: relative;
  z-index: 1;
  padding: 32rpx;
  display: flex;
  flex-direction: column;
}

.banner-top {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.banner-emoji {
  font-size: 48rpx;
}

.banner-tag {
  font-size: 20rpx;
  color: #fff;
  background: rgba(255,255,255,0.3);
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
}

.banner-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 8rpx;
}

.banner-subtitle {
  font-size: 24rpx;
  color: rgba(255,255,255,0.9);
}

.banner-dots {
  display: flex;
  justify-content: center;
  gap: 8rpx;
  padding: 16rpx 0;
}

.banner-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 6rpx;
  background: #E5E5EA;
  transition: all 0.3s;
}

.banner-dot.active {
  width: 32rpx;
  background: #FF6B35;
}

/* 商家列表 */
.merchant-list {
  padding: 0 24rpx;
}

.merchant-card {
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 16rpx rgba(0,0,0,0.05);
}

.merchant-img {
  width: 100%;
  height: 320rpx;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.merchant-emoji {
  font-size: 100rpx;
}

.merchant-tags-overlay {
  position: absolute;
  top: 16rpx;
  left: 16rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.merchant-tag {
  font-size: 20rpx;
  color: #fff;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
}

.merchant-status {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  font-size: 20rpx;
  color: #fff;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
}

.merchant-status.open {
  background: rgba(52,199,89,0.85);
}

.merchant-status.closed {
  background: rgba(0,0,0,0.5);
}

.merchant-body {
  padding: 20rpx 24rpx;
}

.merchant-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #1A1A1A;
  display: block;
  margin-bottom: 8rpx;
}

.merchant-meta {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 8rpx;
  flex-wrap: wrap;
}

.merchant-rating {
  font-size: 24rpx;
  color: #FF9500;
  font-weight: 600;
}

.meta-div {
  font-size: 20rpx;
  color: #D1D1D6;
}

.merchant-distance {
  font-size: 24rpx;
  color: #6B6B6B;
}

.merchant-price-tag {
  font-size: 24rpx;
  color: #FF6B35;
  font-weight: 600;
}

.merchant-sold {
  font-size: 24rpx;
  color: #9B9B9B;
}

.merchant-cuisine {
  font-size: 24rpx;
  color: #6B6B6B;
  margin-bottom: 8rpx;
}

.merchant-hours {
  font-size: 22rpx;
  color: #9B9B9B;
  margin-bottom: 12rpx;
}

.hours-open {
  color: #34C759;
}

.hours-closed {
  color: #C7C7CC;
}

.merchant-promo {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.promo-tag {
  font-size: 20rpx;
  color: #FF6B35;
  background: rgba(255,107,53,0.1);
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
}

/* 特价美食 */
.deal-scroll {
  width: 100%;
  white-space: nowrap;
}

.deal-cards {
  display: flex;
  gap: 20rpx;
  padding: 0 24rpx;
}

.deal-card {
  display: inline-block;
  width: 260rpx;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05);
  flex-shrink: 0;
}

.deal-img {
  width: 100%;
  height: 180rpx;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.deal-emoji {
  font-size: 64rpx;
}

.deal-badge {
  position: absolute;
  top: 12rpx;
  left: 12rpx;
  background: #FF3B30;
  color: #fff;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-weight: 600;
}

.deal-body {
  padding: 16rpx;
}

.deal-title {
  font-size: 26rpx;
  color: #1A1A1A;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-bottom: 8rpx;
}

.deal-sold {
  font-size: 22rpx;
  color: #9B9B9B;
  display: block;
  margin-bottom: 8rpx;
}

.deal-price {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.deal-price-now {
  font-size: 32rpx;
  color: #FF6B35;
  font-weight: 700;
}

.deal-price-old {
  font-size: 22rpx;
  color: #C7C7CC;
  text-decoration: line-through;
}

/* 限时秒杀 */
.flash-timer {
  font-size: 28rpx;
  color: #FF3B30;
  font-weight: 700;
  background: rgba(255,59,48,0.1);
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
}

.flash-scroll {
  width: 100%;
  white-space: nowrap;
}

.flash-list {
  display: flex;
  gap: 20rpx;
  padding: 0 24rpx;
}

.flash-item {
  display: inline-flex;
  width: 280rpx;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05);
  flex-shrink: 0;
}

.flash-img {
  width: 160rpx;
  height: 160rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.flash-emoji {
  font-size: 56rpx;
}

.flash-body {
  padding: 16rpx;
  flex: 1;
  min-width: 0;
}

.flash-title {
  font-size: 24rpx;
  color: #1A1A1A;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-bottom: 8rpx;
}

.flash-price-row {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  margin-bottom: 8rpx;
}

.flash-price {
  font-size: 30rpx;
  color: #FF3B30;
  font-weight: 700;
}

.flash-orig {
  font-size: 20rpx;
  color: #C7C7CC;
  text-decoration: line-through;
}

.flash-progress {
  position: relative;
  height: 28rpx;
  background: #F5F5F7;
  border-radius: 14rpx;
  overflow: hidden;
}

.flash-progress-bar {
  position: absolute;
  top: 0; left: 0; bottom: 0;
  background: linear-gradient(90deg, #FF6B35, #FF9500);
  border-radius: 14rpx;
  transition: width 0.3s;
}

.flash-progress-text {
  position: relative;
  z-index: 1;
  font-size: 18rpx;
  color: #fff;
  line-height: 28rpx;
  text-align: center;
  display: block;
}

/* 搜索弹层 */
.search-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.4);
  z-index: 1000;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.25s;
}

.search-overlay.show {
  opacity: 1;
  pointer-events: auto;
}

.search-panel {
  background: #fff;
  border-radius: 0 0 24rpx 24rpx;
  padding: 24rpx;
  padding-top: calc(24rpx + var(--status-bar-height, 44rpx));
}

.search-panel-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 32rpx;
}

.search-panel-input {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 12rpx;
  height: 72rpx;
  background: #F5F5F7;
  border-radius: 36rpx;
  padding: 0 24rpx;
}

.search-panel-input input {
  flex: 1;
  font-size: 28rpx;
}

.search-cancel {
  font-size: 28rpx;
  color: #FF6B35;
  flex-shrink: 0;
}

.search-hot-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1A1A1A;
  display: block;
  margin-bottom: 20rpx;
}

.search-hot-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.search-hot-tag {
  padding: 12rpx 28rpx;
  background: #F5F5F7;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #6B6B6B;
}

.search-hot-tag.hot {
  color: #FF6B35;
  font-weight: 600;
}
