<!-- pages/profile/profile.wxml -->
<view class="page">
  <view class="status-bar-placeholder" style="height: {{statusBarHeight}}px;"></view>

  <scroll-view scroll-y class="page-scroll" enhanced show-scrollbar="{{false}}">

    <!-- 用户信息卡片 -->
    <view class="profile-header">
      <view class="profile-bg"></view>
      <view class="profile-user-card">
        <view class="profile-avatar" style="background:{{userInfo.avatarBg}};">
          <text class="profile-avatar-emoji">{{userInfo.avatarEmoji}}</text>
        </view>
        <view class="profile-user-info">
          <text class="profile-name">{{userInfo.name}}</text>
          <view class="profile-level">
            <text class="level-badge">{{userInfo.level}}</text>
            <text class="level-text">{{userInfo.levelText}}</text>
          </view>
          <view class="profile-stats">
            <view class="stat-item">
              <text class="stat-num">{{userInfo.following}}</text>
              <text class="stat-label">关注</text>
            </view>
            <view class="stat-item">
              <text class="stat-num">{{userInfo.followers}}</text>
              <text class="stat-label">粉丝</text>
            </view>
            <view class="stat-item">
              <text class="stat-num">{{userInfo.posts}}</text>
              <text class="stat-label">动态</text>
            </view>
          </view>
        </view>
        <view class="profile-edit-btn" bindtap="onEditTap">
          <text class="edit-icon">✏️</text>
        </view>
      </view>
    </view>

    <!-- 资产卡片 -->
    <view class="profile-assets">
      <view class="asset-item">
        <text class="asset-num">¥{{userInfo.walletBalance}}</text>
        <text class="asset-label">钱包余额</text>
      </view>
      <view class="asset-divider"></view>
      <view class="asset-item">
        <text class="asset-num">{{userInfo.coupons}}</text>
        <text class="asset-label">优惠券</text>
      </view>
      <view class="asset-divider"></view>
      <view class="asset-item">
        <text class="asset-num">{{userInfo.points}}</text>
        <text class="asset-label">积分</text>
      </view>
    </view>

    <!-- 订单管理 -->
    <view class="profile-section">
      <view class="section-header">
        <text class="section-title">我的订单</text>
        <text class="more-link">全部订单 ›</text>
      </view>
      <view class="order-grid">
        <view
          class="order-item"
          wx:for="{{orderStatuses}}"
          wx:key="name"
          data-name="{{item.name}}"
          bindtap="onOrderTap"
        >
          <view class="order-icon-wrap">
            <view class="order-icon" style="background:{{item.bg}};">
              <text class="order-emoji">{{item.emoji}}</text>
            </view>
            <view class="order-badge" wx:if="{{item.badge}}">{{item.badge}}</view>
          </view>
          <text class="order-label">{{item.name}}</text>
        </view>
      </view>
    </view>

    <!-- 常用功能 -->
    <view class="profile-section">
      <view class="section-header">
        <text class="section-title">常用功能</text>
      </view>
      <view class="func-grid">
        <view
          class="func-item"
          wx:for="{{funcItems}}"
          wx:key="name"
          data-name="{{item.name}}"
          bindtap="onFuncTap"
        >
          <view class="func-icon" style="background:{{item.bg}};">
            <text class="func-emoji">{{item.emoji}}</text>
          </view>
          <text class="func-label">{{item.name}}</text>
        </view>
      </view>
    </view>

    <!-- 系统设置 -->
    <view class="profile-section">
      <view class="section-header">
        <text class="section-title">系统设置</text>
      </view>
      <view class="settings-list">
        <view
          class="setting-item"
          wx:for="{{settings}}"
          wx:key="label"
          data-label="{{item.label}}"
          bindtap="onSettingTap"
        >
          <view class="setting-icon" style="background:{{item.bg}};">
            <text class="setting-emoji">{{item.emoji}}</text>
          </view>
          <text class="setting-label">{{item.label}}</text>
          <text class="setting-value" wx:if="{{item.value}}">{{item.value}}</text>
          <text class="setting-arrow">›</text>
        </view>
      </view>
    </view>

    <view style="height: 140rpx;"></view>
  </scroll-view>
</view>
