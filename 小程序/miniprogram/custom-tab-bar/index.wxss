/* custom-tab-bar/index.wxss */
.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 120rpx;
  display: flex;
  align-items: center;
  justify-content: space-around;
  background: #FFFFFF;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.06);
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 999;
}

.tab-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex: 1;
  height: 100%;
  position: relative;
}

.tab-emoji {
  font-size: 44rpx;
  line-height: 1;
  margin-bottom: 6rpx;
  opacity: 0.5;
  transition: all 0.2s;
}

.emoji-active {
  opacity: 1;
  transform: scale(1.15);
}

.tab-text {
  font-size: 20rpx;
  color: #8E8E93;
  transition: color 0.2s;
}

.text-active {
  color: #FF6B35;
  font-weight: 600;
}

/* 小秘中心按钮 */
.center-tab {
  position: relative;
}

.center-btn {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FF6B35, #FFB627);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: -30rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 53, 0.4);
  border: 6rpx solid #FFFFFF;
}

.center-emoji {
  font-size: 44rpx;
  line-height: 1;
}

.center-text {
  font-size: 20rpx;
  color: #FF6B35;
  font-weight: 600;
  margin-top: 4rpx;
}
