/* app.wxss - 全局样式 */

/* 颜色变量 */
page {
  --primary: #FF6B35;
  --primary-light: #FF9A56;
  --primary-dark: #E55A2B;
  --bg: #F5F5F7;
  --card-bg: #FFFFFF;
  --text-1: #1A1A1A;
  --text-2: #6B6B6B;
  --text-3: #9B9B9B;
  --border: #E5E5EA;
  --green: #34C759;
  --blue: #007AFF;
  --purple: #5856D6;
  --orange: #FF9500;
  --pink: #FF2D55;
  --teal: #00C7BE;

  background-color: var(--bg);
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', Arial, sans-serif;
  font-size: 28rpx;
  color: var(--text-1);
  -webkit-font-smoothing: antialiased;
}

/* 通用样式 */
.container {
  min-height: 100vh;
  box-sizing: border-box;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 24rpx 16rpx;
}

.section-header h3 {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-1);
}

.section-header .more-link {
  font-size: 24rpx;
  color: var(--text-3);
}

/* 渐变背景工具类 */
.bg-food { background: linear-gradient(135deg,#FF6B35,#FF9A56); }
.bg-massage { background: linear-gradient(135deg,#34C759,#30D158); }
.bg-car { background: linear-gradient(135deg,#007AFF,#5AC8FA); }
.bg-camera { background: linear-gradient(135deg,#AF52DE,#D65BFF); }
.bg-plane { background: linear-gradient(135deg,#FF9500,#FFB800); }
.bg-fitness { background: linear-gradient(135deg,#FF2D55,#FF6B6B); }
.bg-mic { background: linear-gradient(135deg,#5856D6,#7B79F0); }
.bg-film { background: linear-gradient(135deg,#00C7BE,#30D5C8); }
.bg-orange { background: linear-gradient(135deg,#FF6B35,#FF9A56); }
.bg-blue { background: linear-gradient(135deg,#007AFF,#5AC8FA); }
.bg-green { background: linear-gradient(135deg,#34C759,#30D158); }
.bg-purple { background: linear-gradient(135deg,#5856D6,#7B79F0); }
.bg-pink { background: linear-gradient(135deg,#FF2D55,#FF6B6B); }
.bg-teal { background: linear-gradient(135deg,#00C7BE,#30D5C8); }
.bg-gray { background: linear-gradient(135deg,#8E8E93,#AEAEB2); }

/* 圆形图标容器 */
.icon-circle {
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  font-size: 32rpx;
}

/* 价格样式 */
.price-now {
  color: var(--primary);
  font-weight: 700;
}

.price-old {
  color: var(--text-3);
  text-decoration: line-through;
  font-size: 22rpx;
  margin-left: 8rpx;
}

/* 标签样式 */
.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  color: #fff;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.empty-text {
  color: var(--text-3);
  font-size: 26rpx;
  text-align: center;
  line-height: 1.6;
}

/* 渐变占位图 */
.gradient-img {
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  position: relative;
}

.gradient-img::after {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.1);
}

/* 评分星星 */
.rating-star {
  color: #FFB627;
  font-size: 24rpx;
}
